# Variables del paquete database (migraciones, seed y pruebas de integridad).
# Copiar a database/.env y ajustar si hace falta. El .env real nunca se sube.
# Son credenciales de desarrollo local definidas en docker-compose.yml; no son secretos.

# Puerto del host donde docker compose publica PostgreSQL (por defecto 5432).
# Solo documentación: docker compose no lee este archivo, lee el entorno o el .env de la raíz.
# Si 5432 ya lo usa otro PostgreSQL, levantar la base con: DB_PORT=5435 npm run db:up
# y usar ese mismo puerto (5435) en DATABASE_URL y TEST_DATABASE_URL de este archivo.
DB_PORT=5432

# Base de desarrollo (migraciones y seed).
DATABASE_URL=postgres://vaquita:vaquita@localhost:5432/vaquita

# Base de pruebas de integración, en el mismo contenedor. La crea
# database/docker/init/01-create-test-db.sql al inicializar el volumen.
# Si no existe (volumen creado antes de este script): docker compose down -v && npm run db:up
TEST_DATABASE_URL=postgres://vaquita:vaquita@localhost:5432/vaquita_test
