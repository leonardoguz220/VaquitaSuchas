# URL del backend al que reenvía el proxy /api/[...path] (en local: http://localhost:3001).
# Copia este archivo a .env.local y completa el valor; no subas valores reales.
BACKEND_URL=

# Modo del bot de Telegram en el navegador. Déjalo vacío; con `dev` se habilita la pantalla
# /dev/telegram, que simula el bot (debe coincidir con TELEGRAM_MODE=dev del backend).
NEXT_PUBLIC_TELEGRAM_MODE=
