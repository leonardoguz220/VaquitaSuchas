# Variables de entorno del backend de Vaquita (plan.md §5).
# Copiar a `.env` (ignorado por git) y completar. Nunca poner valores reales aquí.
# Los valores en blanco o con TODO se completan localmente; los secretos se generan
# aleatorios (por ejemplo `openssl rand -hex 32`).

# --- Generales ---------------------------------------------------------------
# Entorno de ejecución: development | test | production. Swagger solo se publica en development y test.
NODE_ENV=development
# Puerto HTTP del backend (el frontend en :3000 le reenvía por el proxy /api).
PORT=3001
# Opcional: origen del frontend que CORS admite (esquema y host, sin ruta ni barra final, sin comodines).
# Déjala en blanco: el navegador no llama al backend (lo hace el proxy /api de Next.js) y CORS queda cerrado.
# Ejemplo: https://vaquita.example
FRONTEND_ORIGIN=

# Opcional: correo de contacto del equipo para apelar una suspensión o un baneo (spec 009, RF-009-11).
# Aparece en el correo de suspensión; en blanco, el correo no lo menciona.
APPEAL_EMAIL=

# --- Base de datos -----------------------------------------------------------
# Cadena de conexión de PostgreSQL con el rol de aplicación (ver database/.env.example para el valor local).
# Formato: postgresql://usuario:clave@host:puerto/base
DATABASE_URL=TODO

# --- Secretos de seguridad ---------------------------------------------------
# Clave para firmar los JWT de sesión (mínimo 32 caracteres aleatorios).
JWT_SECRET=
# Clave para las huellas irreversibles (HMAC) de baneos y límites de intentos.
FINGERPRINT_KEY=
# Clave de cifrado de la cédula de identidad (32 bytes en hexadecimal o base64).
CI_ENCRYPTION_KEY=
# Token del disparador de tareas programadas POST /internal/jobs/tick (32 bytes aleatorios).
JOBS_TOKEN=

# --- Modos de los servicios externos -----------------------------------------
# Correo: dev (SMTP a Mailpit local) | prod (API HTTPS del proveedor).
MAIL_MODE=dev
# Bot de Telegram: dev (simulador en memoria, sin salir a internet) | prod (api.telegram.org).
TELEGRAM_MODE=dev
# Almacén de comprobantes y QR: local (carpeta no pública) | supabase (Supabase Storage).
STORAGE_DRIVER=local
# Tareas programadas dentro del proceso con @nestjs/schedule: true | false.
# En Render gratuito se usa false y se llama a POST /internal/jobs/tick desde un cron externo.
JOBS_INPROCESS=true

# --- Correo ------------------------------------------------------------------
# Solo MAIL_MODE=dev: servidor SMTP de Mailpit (interfaz web en http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
# Solo MAIL_MODE=prod: proveedor de correo por API HTTPS (resend | brevo).
MAIL_PROVIDER=resend
# Solo MAIL_MODE=prod: clave de API del proveedor de correo (Resend).
RESEND_API_KEY=
# Solo MAIL_MODE=prod y MAIL_PROVIDER=brevo: clave de API de Brevo (en lugar de RESEND_API_KEY).
BREVO_API_KEY=
# Remitente: «correo@dominio» o «Nombre <correo@dominio>». Obligatorio con MAIL_MODE=prod (debe estar
# verificado en el proveedor); en dev es opcional y por omisión es «Vaquita <no-reply@vaquita.local>».
MAIL_FROM=

# --- Telegram ----------------------------------------------------------------
# Solo TELEGRAM_MODE=prod: token del bot entregado por @BotFather.
TELEGRAM_BOT_TOKEN=
# Solo TELEGRAM_MODE=prod: secreto aleatorio que Telegram envía en el encabezado del webhook.
TELEGRAM_WEBHOOK_SECRET=
# Solo TELEGRAM_MODE=prod: URL pública del backend donde Telegram entrega los mensajes (la usa cli/telegram-set-webhook).
TELEGRAM_WEBHOOK_URL=

# --- Almacén de archivos -----------------------------------------------------
# Solo STORAGE_DRIVER=local: carpeta donde se guardan los archivos (fuera de cualquier ruta pública).
STORAGE_LOCAL_DIR=.storage
# Solo STORAGE_DRIVER=supabase: URL del proyecto de Supabase.
SUPABASE_URL=
# Solo STORAGE_DRIVER=supabase: clave de servicio (secreta, solo en el servidor).
SUPABASE_SERVICE_KEY=
# Solo STORAGE_DRIVER=supabase: nombre del bucket privado.
SUPABASE_BUCKET=

# --- Semillas de desarrollo (cli/seed-admin y cli/seed-dev-users) -----------------
# Administrador (npm run seed:admin): necesita las tres; en NODE_ENV=production solo corre con --allow-production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
# Usuarios de prueba (npm run seed:dev-users): solo si NODE_ENV no es production; una contraseña común.
SEED_DEV_PASSWORD=
